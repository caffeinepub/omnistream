# OmniStream Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# Internet Identity Configuration
# =============================================================================

# Internet Identity Provider URL
# - Local development: http://localhost:4943/?canisterId=<local-ii-canister-id>
# - IC Mainnet: https://identity.ic0.app (default, auto-configured)
# - IC Testnet: https://identity.internetcomputer.org
II_URL=https://identity.ic0.app

# Internet Identity Derivation Origin (optional)
# Used for consistent principal derivation across domains
# Only needed if using custom domains or specific derivation requirements
# II_DERIVATION_ORIGIN=https://your-custom-domain.com

# =============================================================================
# Canister Configuration
# =============================================================================

# Backend Canister ID
# - Auto-detected from canister_ids.json in production
# - For local development, generated by dfx
# BACKEND_CANISTER_ID=<your-backend-canister-id>

# Frontend Canister ID (usually not needed, auto-detected)
# FRONTEND_CANISTER_ID=<your-frontend-canister-id>

# =============================================================================
# Network Configuration
# =============================================================================

# DFX Network
# - local: Local replica (default for development)
# - ic: Internet Computer mainnet
# - playground: IC playground (temporary testing)
DFX_NETWORK=ic

# =============================================================================
# Admin Configuration
# =============================================================================

# Admin Token (for first-time admin initialization)
# Pass this via URL hash for security: https://your-app.ic0.app/#caffeineAdminToken=your-secret-token
# The token is automatically extracted from the hash and stored in sessionStorage
# NEVER commit this token to version control
# CAFFEINE_ADMIN_TOKEN=your-secret-admin-token-here

# =============================================================================
# Build Configuration
# =============================================================================

# Node Environment
# - development: Development mode with debugging
# - production: Production mode with optimizations
NODE_ENV=production

# =============================================================================
# Notes
# =============================================================================

# 1. Local Development:
#    - Run `dfx start --clean` to start local replica
#    - Run `dfx deploy` to deploy canisters locally
#    - Frontend will auto-detect local canister IDs
#
# 2. Mainnet Deployment:
#    - Ensure II_URL points to production Internet Identity
#    - Run `dfx deploy --network ic` to deploy to mainnet
#    - Canister IDs are auto-detected from canister_ids.json
#
# 3. Security:
#    - Never commit .env.local to version control
#    - Use URL hash for admin tokens (not query params)
#    - Admin tokens are cleared from URL after extraction
#
# 4. Internet Identity:
#    - Production II works automatically on mainnet
#    - For local development, deploy II canister locally
#    - See: https://internetcomputer.org/docs/current/developer-docs/identity/internet-identity/integrate-internet-identity
